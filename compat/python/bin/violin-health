#!/usr/bin/env python3
"""Qwen Code CLI runtime preflight. Exit 0 only on the expected final response."""
import json
import os
import subprocess
import sys

SMOKE_OK = "VIOLIN_QWEN_CODE_SMOKE_OK"


def main():
    binary = os.environ.get("VIOLIN_QWEN_BIN", "qwen")
    model = os.environ.get("VIOLIN_QWEN_MODEL", "qwen3.8-27b")
    timeout = float(os.environ.get("VIOLIN_SMOKE_TIMEOUT", "35"))
    command = [binary, "--safe-mode", "--auth-type", "openai", "--model", model,
               "--approval-mode", "plan", "--max-tool-calls", "0",
               "--max-wall-time", f"{timeout}s", "--output-format", "stream-json",
               "-p", f"Reply exactly {SMOKE_OK}. Do not use tools."]
    evidence = {"model": model, "interface": "qwen-code-cli", "smoke_status": "failed"}
    try:
        smoke = subprocess.run(command, capture_output=True, text=True, timeout=timeout + 3)
    except subprocess.TimeoutExpired as exc:
        evidence.update(status="qwen_unhealthy", error="smoke_timeout",
                        stdout_present=bool(exc.stdout), stderr_present=bool(exc.stderr))
        print(json.dumps(evidence, ensure_ascii=False))
        return 79
    except OSError as exc:
        evidence.update(status="qwen_unhealthy", error=f"smoke_launch_error: {type(exc).__name__}")
        print(json.dumps(evidence, ensure_ascii=False))
        return 79
    evidence.update(command=[binary, "--auth-type", "openai", "--model", model],
                    exit_code=smoke.returncode)
    if smoke.returncode == 55:
        evidence.update(status="qwen_unhealthy", error="qwen_cli_budget_exceeded")
    for line in smoke.stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("type") == "result":
            evidence["result_status"] = event.get("subtype")
            evidence["final_response_seen"] = isinstance(event.get("result"), str)
            if event.get("subtype") == "success" and not event.get("is_error") and event.get("result") == SMOKE_OK:
                evidence.update(status="ready", smoke_status="passed")
                print(json.dumps(evidence, ensure_ascii=False))
                return 0
            evidence["error"] = "unexpected smoke response"
    evidence.setdefault("status", "qwen_unhealthy")
    evidence.setdefault("error", "Qwen Code did not return the expected successful final response")
    print(json.dumps(evidence, ensure_ascii=False))
    return 79


if __name__ == "__main__":
    sys.exit(main())
