#!/usr/bin/env python3
"""Small stdio MCP server: Codex supervises external Qwen/AGY processes."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import uuid
import fcntl

RUNNER = Path(__file__).resolve().with_name("violin-worker")
HEALTH = Path(__file__).resolve().with_name("violin-health")
JOBS = {}
DEFAULT_LIMITS = {"qwen": 1, "agy": 2}


def limits():
    values = {}
    for backend, default in DEFAULT_LIMITS.items():
        try:
            value = int(os.environ.get(f"VIOLIN_{backend.upper()}_MAX_CONCURRENCY", default))
        except ValueError:
            value = default
        values[backend] = max(0, value)
    return values


def lease_paths(root):
    directory = root / "leases"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    return directory, directory / ".lock"


def process_alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def reserve(root, requested):
    directory, lock_path = lease_paths(root)
    quota = limits()
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        active = []
        for path in directory.glob("*.json"):
            try:
                lease = json.loads(path.read_text())
            except (ValueError, OSError):
                path.unlink(missing_ok=True)
                continue
            if not process_alive(lease.get("server_pid")) or (
                lease.get("worker_pid") is not None and not process_alive(lease.get("worker_pid"))
            ):
                path.unlink(missing_ok=True)
                continue
            active.append((path, lease))
        order = ["qwen", "agy"] if requested == "auto" else [requested]
        selected = next((backend for backend in order
                         if sum(x.get("backend") == backend for _, x in active) < quota[backend]), None)
        if selected is None:
            fcntl.flock(lock, fcntl.LOCK_UN)
            return None, {backend: sum(x.get("backend") == backend for _, x in active)
                           for backend in DEFAULT_LIMITS}, quota
        lease_path = directory / f"{uuid.uuid4()}.json"
        lease_path.write_text(json.dumps({"backend": selected, "server_pid": os.getpid(),
                                          "worker_pid": None, "created_at": time.time()}))
        fcntl.flock(lock, fcntl.LOCK_UN)
    return lease_path, {backend: sum(x.get("backend") == backend for _, x in active)
                        for backend in DEFAULT_LIMITS}, quota


def update_lease(path, worker_pid):
    if path is None:
        return
    try:
        value = json.loads(path.read_text())
        value["worker_pid"] = worker_pid
        path.write_text(json.dumps(value))
    except (ValueError, OSError):
        pass


def release_lease(path):
    if path is not None:
        path.unlink(missing_ok=True)


def qwen_health():
    try:
        process = subprocess.run([str(HEALTH)], capture_output=True, text=True, timeout=75)
        return process.returncode == 0, json.loads(process.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        return False, {"status": "qwen_unhealthy", "error": type(exc).__name__}


def snapshot(job):
    code = job["process"].poll()
    result = {"agent_id": job["id"], "backend": job["backend"],
              "status": "running" if code is None else "failed"}
    try:
        live = json.loads(job["status"].read_text())
        result.update({key: live[key] for key in
                       ("phase", "last_event_at", "elapsed_seconds", "evidence") if key in live})
    except (ValueError, OSError):
        pass
    if code is not None:
        release_lease(job.get("lease"))
        try:
            report = json.loads(job["output"].read_text())
            result.update(report)
        except (ValueError, OSError):
            result.update(error="Worker ended without a valid report", exit_code=code,
                          evidence=str(job["output"].parent))
    return result


def dispatch(name, args):
    if name == "spawn_agent":
        requested_backend = args.get("backend", "auto")
        mode = args.get("mode", "inspect")
        task = args.get("task", "")
        cwd = Path(args.get("cwd", "")).expanduser()
        if requested_backend not in ("qwen", "agy", "auto") or mode not in ("inspect", "implement"):
            raise ValueError("Invalid backend or mode")
        if not isinstance(task, str) or not task.strip():
            raise ValueError("A nonempty task is required")
        if not cwd.is_absolute() or not cwd.is_dir():
            raise ValueError("cwd must be an existing absolute directory")
        timeout = args.get("timeout_seconds", 900)
        if type(timeout) is not int or not 1 <= timeout <= 3600:
            raise ValueError("timeout_seconds must be between 1 and 3600")
        idle_timeout = args.get("idle_timeout_seconds", 300)
        if type(idle_timeout) is not int or not 1 <= idle_timeout <= 3600:
            raise ValueError("idle_timeout_seconds must be between 1 and 3600")
        root = Path(os.environ.get("VIOLIN_WORKER_RUNS", str(Path.home() / ".local/state/violin-workers")))
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        health_failed, health_evidence = False, None
        if requested_backend == "auto":
            healthy, health_evidence = qwen_health()
            health_failed = not healthy
        lease, counts, quota = reserve(root, "agy" if health_failed else requested_backend)
        if lease is None:
            raise ValueError(json.dumps({"error": "worker capacity is full",
                                         "requested_backend": requested_backend,
                                         "capacity_snapshot": counts, "quotas": quota}))
        backend = json.loads(lease.read_text())["backend"]
        directory = Path(tempfile.mkdtemp(prefix="agent-", dir=root))
        taskfile = directory / "task.txt"
        taskfile.write_text(task)
        output = directory / "output.json"
        status_path = directory / "status.json"
        status_path.write_text(json.dumps({"phase": "starting", "last_event_at": time.time(),
                                           "elapsed_seconds": 0, "pid": None,
                                           "timeout_deadline": None, "command_type": None,
                                           "evidence": str(directory)}))
        worker_env = dict(os.environ, VIOLIN_WORKER_STATUS=str(status_path))
        try:
            with output.open("w") as out, (directory / "server-stderr.log").open("w") as err:
                proc = subprocess.Popen([str(RUNNER), backend, "--mode", mode, "-C", str(cwd),
                                         "--task-file", str(taskfile), "--timeout", str(timeout),
                                         "--idle-timeout", str(idle_timeout)],
                                        stdin=subprocess.DEVNULL, stdout=out, stderr=err, env=worker_env,
                                        start_new_session=True)
        except OSError:
            release_lease(lease)
            raise
        update_lease(lease, proc.pid)
        agent_id = str(uuid.uuid4())
        job = {"id": agent_id, "backend": backend, "process": proc, "output": output,
               "status": directory / "status.json", "lease": lease,
               "requested_backend": requested_backend, "capacity_snapshot": counts,
               "quota": quota, "fallback_reason": "qwen_health_failed" if health_failed else "qwen_capacity_full"}
        JOBS[agent_id] = job
        result = snapshot(job)
        result.update({"requested_backend": requested_backend, "selected_backend": backend,
                       "capacity_snapshot": counts, "quotas": quota})
        if requested_backend == "auto" and backend != "qwen":
            result["fallback_reason"] = "qwen_health_failed" if health_failed else "qwen_capacity_full"
            if health_failed:
                result["health_evidence"] = health_evidence
        return result
    if name == "list_agents":
        return [{k: v for k, v in snapshot(job).items() if k in
                 ("agent_id", "backend", "status", "evidence")} for job in JOBS.values()]
    agent_id = args.get("agent_id")
    if agent_id not in JOBS:
        raise ValueError("Unknown agent_id; do not restart an unobserved task automatically")
    job = JOBS[agent_id]
    if name == "wait_agent":
        seconds = args.get("wait_seconds", 50)
        if type(seconds) is not int or not 0 <= seconds <= 50:
            raise ValueError("wait_seconds must be between 0 and 50")
        try:
            job["process"].wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            pass
        result = snapshot(job)
        result.update({"requested_backend": job["requested_backend"],
                       "selected_backend": job["backend"],
                       "capacity_snapshot": job["capacity_snapshot"], "quotas": job["quota"]})
        if job["requested_backend"] == "auto" and job["backend"] != "qwen":
            result["fallback_reason"] = job.get("fallback_reason", "qwen_capacity_full")
        return result
    if name == "interrupt_agent":
        if job["process"].poll() is None:
            # The runner handles SIGINT and terminates its backend process group.
            job["process"].send_signal(signal.SIGINT)
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                return {"agent_id": agent_id, "status": "interrupt_requested"}
        return snapshot(job)
    raise ValueError("Unknown tool")


def schema(properties, required=()):
    return {"type": "object", "properties": properties, "required": list(required),
            "additionalProperties": False}


TOOLS = [
    {"name": "spawn_agent", "description": "Delegate a bounded task to self-hosted Qwen or AGY Gemini 3.8 Flash. Auto prefers Qwen and falls back to AGY only when Qwen capacity is full. Returns a live agent id immediately. Codex retains final review. Send only necessary task/context, scope and acceptance criteria; no full chat history. Use inspect unless edits are authorized.",
     "inputSchema": schema({"backend": {"type": "string", "enum": ["auto", "qwen", "agy"]},
        "task": {"type": "string"}, "cwd": {"type": "string"},
        "mode": {"type": "string", "enum": ["inspect", "implement"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "idle_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}, ["task", "cwd"])},
    {"name": "wait_agent", "description": "Wait up to 50 seconds (default) on the same external agent id. Prefer a full wait to reduce supervisor token overhead. Running is not failure; never restart just because this wait expires. Completed reports contain bounded summary and full evidence paths; verify before accepting.",
     "inputSchema": schema({"agent_id": {"type": "string"}, "wait_seconds": {"type": "integer", "minimum": 0, "maximum": 50}}, ["agent_id"])},
    {"name": "list_agents", "description": "List external worker states by checking their live process handles.", "inputSchema": schema({})},
    {"name": "interrupt_agent", "description": "Stop an external worker and its backend. Does not revert file changes; inspect evidence before continuing.", "inputSchema": schema({"agent_id": {"type": "string"}}, ["agent_id"])},
]


def main():
    try:
        for line in sys.stdin:
            request = json.loads(line)
            if "id" not in request:
                continue
            response = {"jsonrpc": "2.0", "id": request["id"]}
            method = request.get("method")
            if method == "initialize":
                response["result"] = {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}},
                                      "serverInfo": {"name": "violin-agents", "version": "0.1.0"}}
            elif method == "ping":
                response["result"] = {}
            elif method == "tools/list":
                response["result"] = {"tools": TOOLS}
            elif method == "tools/call":
                params = request.get("params", {})
                try:
                    value = dispatch(params["name"], params.get("arguments", {}))
                    response["result"] = {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False)}]}
                except (ValueError, KeyError, OSError) as exc:
                    response["result"] = {"isError": True, "content": [{"type": "text", "text": str(exc)}]}
            else:
                response["error"] = {"code": -32601, "message": "Method not found"}
            print(json.dumps(response), flush=True)
    finally:
        for job in JOBS.values():
            if job["process"].poll() is None:
                job["process"].send_signal(signal.SIGINT)
        for job in JOBS.values():
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                pass


if __name__ == "__main__":
    def terminate(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, terminate)
    main()
