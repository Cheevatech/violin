#!/usr/bin/env python3
"""Small stdio MCP server: Codex supervises external Qwen/AGY processes."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import uuid

RUNNER = Path(__file__).resolve().with_name("violin-worker")
JOBS = {}


def snapshot(job):
    code = job["process"].poll()
    result = {"agent_id": job["id"], "backend": job["backend"],
              "status": "running" if code is None else "failed"}
    try:
        live = json.loads(job["status"].read_text())
        result.update({key: live[key] for key in
                       ("phase", "last_event_at", "elapsed_seconds", "evidence") if key in live})
    except (ValueError, OSError):
        pass
    if code is not None:
        try:
            report = json.loads(job["output"].read_text())
            result.update(report)
        except (ValueError, OSError):
            result.update(error="Worker ended without a valid report", exit_code=code,
                          evidence=str(job["output"].parent))
    return result


def dispatch(name, args):
    if name == "spawn_agent":
        backend = args.get("backend", "qwen")
        mode = args.get("mode", "inspect")
        task = args.get("task", "")
        cwd = Path(args.get("cwd", "")).expanduser()
        if backend not in ("qwen", "agy") or mode not in ("inspect", "implement"):
            raise ValueError("Invalid backend or mode")
        if not isinstance(task, str) or not task.strip():
            raise ValueError("A nonempty task is required")
        if not cwd.is_absolute() or not cwd.is_dir():
            raise ValueError("cwd must be an existing absolute directory")
        if sum(j["process"].poll() is None for j in JOBS.values()) >= 3:
            raise ValueError("Three workers are already running; collect a result first")
        timeout = args.get("timeout_seconds", 900)
        if type(timeout) is not int or not 1 <= timeout <= 3600:
            raise ValueError("timeout_seconds must be between 1 and 3600")
        idle_timeout = args.get("idle_timeout_seconds", 300)
        if type(idle_timeout) is not int or not 1 <= idle_timeout <= 3600:
            raise ValueError("idle_timeout_seconds must be between 1 and 3600")
        root = Path(os.environ.get("VIOLIN_WORKER_RUNS", str(Path.home() / ".local/state/violin-workers")))
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        directory = Path(tempfile.mkdtemp(prefix="agent-", dir=root))
        taskfile = directory / "task.txt"
        taskfile.write_text(task)
        output = directory / "output.json"
        status_path = directory / "status.json"
        status_path.write_text(json.dumps({"phase": "starting", "last_event_at": time.time(),
                                           "elapsed_seconds": 0, "pid": None,
                                           "timeout_deadline": None, "command_type": None,
                                           "evidence": str(directory)}))
        worker_env = dict(os.environ, VIOLIN_WORKER_STATUS=str(status_path))
        with output.open("w") as out, (directory / "server-stderr.log").open("w") as err:
            proc = subprocess.Popen([str(RUNNER), backend, "--mode", mode, "-C", str(cwd),
                                     "--task-file", str(taskfile), "--timeout", str(timeout),
                                     "--idle-timeout", str(idle_timeout)],
                                    stdin=subprocess.DEVNULL, stdout=out, stderr=err, env=worker_env,
                                    start_new_session=True)
        agent_id = str(uuid.uuid4())
        job = {"id": agent_id, "backend": backend, "process": proc, "output": output,
               "status": directory / "status.json"}
        JOBS[agent_id] = job
        return snapshot(job)
    if name == "list_agents":
        return [{k: v for k, v in snapshot(job).items() if k in
                 ("agent_id", "backend", "status", "evidence")} for job in JOBS.values()]
    agent_id = args.get("agent_id")
    if agent_id not in JOBS:
        raise ValueError("Unknown agent_id; do not restart an unobserved task automatically")
    job = JOBS[agent_id]
    if name == "wait_agent":
        seconds = args.get("wait_seconds", 50)
        if type(seconds) is not int or not 0 <= seconds <= 50:
            raise ValueError("wait_seconds must be between 0 and 50")
        try:
            job["process"].wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            pass
        return snapshot(job)
    if name == "interrupt_agent":
        if job["process"].poll() is None:
            # The runner handles SIGINT and terminates its backend process group.
            job["process"].send_signal(signal.SIGINT)
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                return {"agent_id": agent_id, "status": "interrupt_requested"}
        return snapshot(job)
    raise ValueError("Unknown tool")


def schema(properties, required=()):
    return {"type": "object", "properties": properties, "required": list(required),
            "additionalProperties": False}


TOOLS = [
    {"name": "spawn_agent", "description": "Delegate a bounded task to self-hosted Qwen or AGY Gemini 3.8 Flash. Returns a live agent id immediately. Codex retains final review. Send only necessary task/context, absolute workspace, scope and acceptance criteria; no full chat history. Use inspect unless edits are authorized.",
     "inputSchema": schema({"backend": {"type": "string", "enum": ["qwen", "agy"]},
        "task": {"type": "string"}, "cwd": {"type": "string"},
        "mode": {"type": "string", "enum": ["inspect", "implement"]},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "idle_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}, ["task", "cwd"])},
    {"name": "wait_agent", "description": "Wait up to 50 seconds (default) on the same external agent id. Prefer a full wait to reduce supervisor token overhead. Running is not failure; never restart just because this wait expires. Completed reports contain bounded summary and full evidence paths; verify before accepting.",
     "inputSchema": schema({"agent_id": {"type": "string"}, "wait_seconds": {"type": "integer", "minimum": 0, "maximum": 50}}, ["agent_id"])},
    {"name": "list_agents", "description": "List external worker states by checking their live process handles.", "inputSchema": schema({})},
    {"name": "interrupt_agent", "description": "Stop an external worker and its backend. Does not revert file changes; inspect evidence before continuing.", "inputSchema": schema({"agent_id": {"type": "string"}}, ["agent_id"])},
]


def main():
    try:
        for line in sys.stdin:
            request = json.loads(line)
            if "id" not in request:
                continue
            response = {"jsonrpc": "2.0", "id": request["id"]}
            method = request.get("method")
            if method == "initialize":
                response["result"] = {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}},
                                      "serverInfo": {"name": "violin-agents", "version": "0.1.0"}}
            elif method == "ping":
                response["result"] = {}
            elif method == "tools/list":
                response["result"] = {"tools": TOOLS}
            elif method == "tools/call":
                params = request.get("params", {})
                try:
                    value = dispatch(params["name"], params.get("arguments", {}))
                    response["result"] = {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False)}]}
                except (ValueError, KeyError, OSError) as exc:
                    response["result"] = {"isError": True, "content": [{"type": "text", "text": str(exc)}]}
            else:
                response["error"] = {"code": -32601, "message": "Method not found"}
            print(json.dumps(response), flush=True)
    finally:
        for job in JOBS.values():
            if job["process"].poll() is None:
                job["process"].send_signal(signal.SIGINT)
        for job in JOBS.values():
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                pass


if __name__ == "__main__":
    def terminate(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, terminate)
    main()
