#!/usr/bin/env python3
"""Small stdio MCP server: Codex supervises external Qwen/AGY/Claude processes."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from violin_scheduler import (Scheduler, load_config, resolve_timeout,
                               run_custom_health, worker_environment)

RUNNER = Path(__file__).resolve().with_name("violin-worker")
HEALTH = Path(__file__).resolve().with_name("violin-health")
JOBS = {}
# MCP tool_timeout_sec is 60s. Keep synchronous auto preflight below it so
# spawn_agent can always return a lease/agent_id or an explicit fallback.
HEALTH_TIMEOUT = 45
PUBLIC_SUMMARY_CHARS = 1500


def public_response(report, requested_backend=None, selected_backend=None,
                    fallback_reason=None, health_evidence=None):
    """Project the internal worker report into a bounded MCP response.

    The worker's complete report remains in its evidence directory.  This
    projection is deliberately the only report shape returned to the parent
    MCP session, so verbose provider metadata cannot consume supervisor
    context tokens.
    """
    report = report if isinstance(report, dict) else {}
    summary = report.get("summary", "")
    if not isinstance(summary, str):
        summary = str(summary)
    summary_truncated = bool(report.get("summary_truncated"))
    if len(summary) > PUBLIC_SUMMARY_CHARS:
        summary = summary[:PUBLIC_SUMMARY_CHARS]
        summary_truncated = True

    result = {
        "agent_id": report.get("agent_id"),
        "status": report.get("status", "failed"),
        "requested_backend": (requested_backend if requested_backend is not None
                               else report.get("requested_backend")),
        "selected_backend": (selected_backend if selected_backend is not None
                              else report.get("selected_backend", report.get("backend"))),
        "fallback_reason": (fallback_reason if fallback_reason is not None
                             else report.get("fallback_reason")),
        "phase": report.get("phase"),
        "summary": summary,
        "summary_truncated": summary_truncated,
        "changed_files": report.get("changed_files", []),
        "evidence": report.get("evidence"),
        "supervisor_review_required": report.get("supervisor_review_required", True),
    }
    for key in ("effective_timeout_seconds", "timeout_source", "idle_timeout_enabled"):
        if key in report:
            result[key] = report[key]
    if result["status"] == "running":
        for key in ("last_event_at", "elapsed_seconds"):
            if key in report:
                result[key] = report[key]
        return result

    if result["status"] not in ("completed", "no_changes"):
        if "exit_code" in report:
            result["exit_code"] = report["exit_code"]
        if "error_message" in report or "error" in report:
            result["error_message"] = report.get("error_message", report.get("error"))
        result["failure_reason"] = report.get("failure_reason", result["status"])
        if "credential_error" in report:
            result["credential_error"] = report["credential_error"]
        if health_evidence is not None:
            result["health_evidence"] = health_evidence
        elif "health_evidence" in report:
            result["health_evidence"] = report["health_evidence"]
    return result


def qwen_health(config):
    if config.get("custom_commands", {}).get("qwen"):
        custom_health, evidence = run_custom_health(config, "qwen", HEALTH_TIMEOUT)
        if custom_health is not None:
            return custom_health, evidence
        return True, {"status": "custom_command", "skipped": "builtin_qwen_health"}
    try:
        health_env = dict(os.environ, VIOLIN_METADATA_TIMEOUT="8", VIOLIN_SMOKE_TIMEOUT="35")
        if config["commands"].get("qwen") and not config.get("custom_commands", {}).get("qwen"):
            health_env["VIOLIN_QWEN_BIN"] = config["commands"]["qwen"]
        process = subprocess.run([str(HEALTH)], capture_output=True, text=True,
                                 timeout=HEALTH_TIMEOUT, env=health_env)
        return process.returncode == 0, json.loads(process.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        return False, {"status": "qwen_unhealthy", "error": type(exc).__name__}


def snapshot(job):
    code = job["process"].poll()
    result = {"agent_id": job["id"], "backend": job["backend"],
              "status": "running" if code is None else "failed",
              "effective_timeout_seconds": job.get("effective_timeout_seconds"),
              "timeout_source": job.get("timeout_source"),
              "idle_timeout_enabled": job.get("idle_timeout_enabled")}
    try:
        live = json.loads(job["status"].read_text())
        result.update({key: live[key] for key in
                       ("phase", "last_event_at", "elapsed_seconds", "evidence") if key in live})
    except (ValueError, OSError):
        pass
    if code is not None:
        Scheduler.release_lease(job.get("lease"))
        try:
            report = json.loads(job["output"].read_text())
            result.update(report)
        except (ValueError, OSError):
            result.update(error="Worker ended without a valid report", exit_code=code,
                          evidence=str(job["output"].parent))
    return result


def dispatch(name, args):
    if name == "spawn_agent":
        requested_backend = args.get("backend", "auto")
        mode = args.get("mode", "inspect")
        task = args.get("task", "")
        cwd = Path(args.get("cwd", "")).expanduser()
        if requested_backend not in ("qwen", "agy", "claude", "auto") or mode not in ("inspect", "implement"):
            raise ValueError("Invalid backend or mode")
        if not isinstance(task, str) or not task.strip():
            raise ValueError("A nonempty task is required")
        if not cwd.is_absolute() or not cwd.is_dir():
            raise ValueError("cwd must be an existing absolute directory")
        config = load_config()
        timeout, timeout_source = resolve_timeout(config, mode, args.get("timeout_seconds"))
        idle_timeout = args.get("idle_timeout_seconds", 300)
        if type(idle_timeout) is not int or not 1 <= idle_timeout <= 3600:
            raise ValueError("idle_timeout_seconds must be between 1 and 3600")
        root = Path(os.environ.get("VIOLIN_WORKER_RUNS", str(Path.home() / ".local/state/violin-workers")))
        scheduler = Scheduler(root, config, session_id=str(os.getpid()))
        health_failed, health_evidence, unavailable = False, None, set()
        lease = counts = quota = reason = None
        while lease is None:
            lease, counts, quota, reason = scheduler.reserve(requested_backend, unavailable)
            if lease is None or requested_backend != "auto":
                break
            candidate = json.loads(lease.read_text())["backend"]
            if candidate == "qwen":
                healthy, health_evidence = qwen_health(config)
                if not healthy:
                    health_failed = True
                    unavailable.add(candidate)
                    scheduler.release_lease(lease)
                    lease = None
                    continue
            break
        if lease is None:
            raise ValueError(json.dumps({"error": "worker capacity is full",
                                         "requested_backend": requested_backend,
                                         "capacity_snapshot": counts or {}, "quotas": quota or {},
                                         "reason": reason or "backend_capacity_full"}))
        backend = json.loads(lease.read_text())["backend"]
        directory = Path(tempfile.mkdtemp(prefix="agent-", dir=root))
        taskfile = directory / "task.txt"
        taskfile.write_text(task)
        output = directory / "output.json"
        status_path = directory / "status.json"
        status_path.write_text(json.dumps({"phase": "starting", "last_event_at": time.time(),
                                           "elapsed_seconds": 0, "pid": None,
                                           "timeout_deadline": None, "command_type": None,
                                           "evidence": str(directory)}))
        worker_env = worker_environment(dict(os.environ, VIOLIN_WORKER_STATUS=str(status_path)), config)
        try:
            with output.open("w") as out, (directory / "server-stderr.log").open("w") as err:
                proc = subprocess.Popen([str(RUNNER), backend, "--mode", mode, "-C", str(cwd),
                                         "--task-file", str(taskfile), "--timeout", str(timeout),
                                         "--idle-timeout", str(idle_timeout)],
                                        stdin=subprocess.DEVNULL, stdout=out, stderr=err, env=worker_env,
                                        start_new_session=True)
        except OSError:
            scheduler.release_lease(lease)
            raise
        scheduler.update_lease(lease, proc.pid)
        agent_id = str(uuid.uuid4())
        job = {"id": agent_id, "backend": backend, "process": proc, "output": output,
               "status": directory / "status.json", "lease": lease,
               "requested_backend": requested_backend, "capacity_snapshot": counts,
               "quota": quota, "fallback_reason": ("qwen_health_failed" if health_failed else reason),
               "effective_timeout_seconds": timeout, "timeout_source": timeout_source,
               "idle_timeout_enabled": not (backend in ("agy", "qwen") and
                                             not config.get("custom_commands", {}).get(backend, False))}
        if health_evidence is not None:
            job["health_evidence"] = health_evidence
        JOBS[agent_id] = job
        result = snapshot(job)
        result.update({"requested_backend": requested_backend, "selected_backend": backend,
                       "capacity_snapshot": counts, "quotas": quota,
                       "effective_timeout_seconds": timeout, "timeout_source": timeout_source,
                       "idle_timeout_enabled": job["idle_timeout_enabled"]})
        if requested_backend == "auto" and (reason or health_failed):
            result["fallback_reason"] = ("qwen_health_failed" if health_failed else reason)
            if health_failed:
                result["health_evidence"] = health_evidence
        return public_response(result, requested_backend, backend,
                               result.get("fallback_reason"), result.get("health_evidence"))
    if name == "list_agents":
        return [public_response(snapshot(job), job["requested_backend"], job["backend"],
                                job.get("fallback_reason")) for job in JOBS.values()]
    agent_id = args.get("agent_id")
    if agent_id not in JOBS:
        raise ValueError("Unknown agent_id; do not restart an unobserved task automatically")
    job = JOBS[agent_id]
    if name == "wait_agent":
        seconds = args.get("wait_seconds", 50)
        if type(seconds) is not int or not 0 <= seconds <= 50:
            raise ValueError("wait_seconds must be between 0 and 50")
        try:
            job["process"].wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            pass
        result = snapshot(job)
        result.update({"requested_backend": job["requested_backend"],
                       "selected_backend": job["backend"],
                       "capacity_snapshot": job["capacity_snapshot"], "quotas": job["quota"]})
        if job["requested_backend"] == "auto" and job.get("fallback_reason"):
            result["fallback_reason"] = job["fallback_reason"]
            if job.get("health_evidence") is not None:
                result["health_evidence"] = job["health_evidence"]
        return public_response(result, job["requested_backend"], job["backend"],
                               result.get("fallback_reason"), result.get("health_evidence"))
    if name == "interrupt_agent":
        if job["process"].poll() is None:
            # The runner handles SIGINT and terminates its backend process group.
            job["process"].send_signal(signal.SIGINT)
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                return public_response({"agent_id": agent_id, "status": "running",
                                        "phase": "interrupt_requested",
                                        "evidence": str(job["output"].parent)},
                                       job["requested_backend"], job["backend"])
        result = snapshot(job)
        return public_response(result, job["requested_backend"], job["backend"],
                               result.get("fallback_reason", job.get("fallback_reason")),
                               result.get("health_evidence", job.get("health_evidence")))
    raise ValueError("Unknown tool")


def schema(properties, required=()):
    return {"type": "object", "properties": properties, "required": list(required),
            "additionalProperties": False}


TOOLS = [
    {"name": "spawn_agent", "description": "Delegate a bounded task to AGY, self-hosted Qwen, or Claude Code. Auto prefers AGY, then Qwen, then Claude when capacity or Qwen health prevents earlier choices. Timeout defaults are selected by mode (inspect/implement) from config; timeout_seconds is an optional override. Built-in Qwen and AGY use hard timeout without idle timeout. Returns a bounded live status/report; full details remain in evidence. If summary_truncated=true, open the report/log there when needed. Codex retains final review. Send only necessary task/context, scope and acceptance criteria; use inspect unless edits are authorized.",
     "inputSchema": schema({"backend": {"type": "string", "enum": ["auto", "agy", "qwen", "claude"]},
        "task": {"type": "string"}, "cwd": {"type": "string"},
        "mode": {"type": "string", "enum": ["inspect", "implement"]},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "idle_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}, ["task", "cwd"])},
    {"name": "wait_agent", "description": "Wait up to 50 seconds (default) on the same external agent id. Prefer a full wait to reduce supervisor token overhead. Returns a bounded summary; full details remain in evidence. If summary_truncated=true, open the report/log there when needed. Running is not failure; never restart just because this wait expires.",
     "inputSchema": schema({"agent_id": {"type": "string"}, "wait_seconds": {"type": "integer", "minimum": 0, "maximum": 50}}, ["agent_id"])},
    {"name": "list_agents", "description": "List bounded external worker states by checking their live process handles; full details remain in each evidence directory.", "inputSchema": schema({})},
    {"name": "interrupt_agent", "description": "Stop an external worker and its backend. Returns a bounded status; full details remain in evidence. Does not revert file changes; inspect evidence before continuing.", "inputSchema": schema({"agent_id": {"type": "string"}}, ["agent_id"])},
]


def main():
    try:
        for line in sys.stdin:
            request = json.loads(line)
            if "id" not in request:
                continue
            response = {"jsonrpc": "2.0", "id": request["id"]}
            method = request.get("method")
            if method == "initialize":
                response["result"] = {"protocolVersion": "2024-11-05", "capabilities": {"tools": {}},
                                      "serverInfo": {"name": "violin-agents", "version": "0.1.0"}}
            elif method == "ping":
                response["result"] = {}
            elif method == "tools/list":
                response["result"] = {"tools": TOOLS}
            elif method == "tools/call":
                params = request.get("params", {})
                try:
                    value = dispatch(params["name"], params.get("arguments", {}))
                    response["result"] = {"content": [{"type": "text", "text": json.dumps(value, ensure_ascii=False)}]}
                except (ValueError, KeyError, OSError) as exc:
                    response["result"] = {"isError": True, "content": [{"type": "text", "text": str(exc)}]}
            else:
                response["error"] = {"code": -32601, "message": "Method not found"}
            print(json.dumps(response), flush=True)
    finally:
        for job in JOBS.values():
            if job["process"].poll() is None:
                job["process"].send_signal(signal.SIGINT)
        for job in JOBS.values():
            try:
                job["process"].wait(timeout=8)
            except subprocess.TimeoutExpired:
                pass


if __name__ == "__main__":
    def terminate(signum, frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, terminate)
    main()
