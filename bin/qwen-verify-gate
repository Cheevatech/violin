#!/bin/sh
set -eu

repo=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] || { printf '%s\n' 'Missing directory after --repo' >&2; exit 2; }
      repo=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      printf '%s\n' 'Usage: qwen-verify-gate --repo DIR -- COMMAND' >&2
      exit 2
      ;;
  esac
done

[ -n "$repo" ] || { printf '%s\n' 'The --repo option is required.' >&2; exit 2; }
[ "$#" -gt 0 ] || { printf '%s\n' 'A verification command is required after --.' >&2; exit 2; }

git -C "$repo" diff --check
printf '%s\n' '--- working tree ---'
git -C "$repo" status --short
printf '%s\n' '--- verification ---'
(
  cd "$repo"
  "$@"
)
