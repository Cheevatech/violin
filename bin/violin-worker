#!/usr/bin/env python3
"""Run a bounded external worker; keep full evidence outside parent context."""
import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import threading
import time

METADATA = Path(__file__).resolve().with_name("violin-qwen-metadata")


def atomic_json(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2))
    os.replace(temporary, path)


class Activity:
    def __init__(self, path, deadline):
        self.path, self.deadline = path, deadline
        self.started = time.monotonic()
        self.last_event = self.started
        self.last_event_at = time.time()
        self.phase, self.command_type, self.pid, self.failure_reason = "starting", None, None, None
        self.lock = threading.Lock()

    def write(self):
        atomic_json(self.path, {"phase": self.phase, "last_event_at": self.last_event_at,
                                "elapsed_seconds": round(time.monotonic() - self.started, 2),
                                "pid": self.pid, "timeout_deadline": self.deadline,
                                "command_type": self.command_type, "evidence": str(self.path.parent)})

    def event(self, phase, command_type=None):
        with self.lock:
            self.phase = phase
            if command_type:
                self.command_type = command_type
            self.last_event = time.monotonic()
            self.last_event_at = time.time()
            self.write()

    def heartbeat(self):
        with self.lock:
            self.write()


def command(backend, mode, cwd, result, timeout):
    if backend == "qwen":
        return [os.environ.get("VIOLIN_QWEN_BIN", str(Path.home() / "bin/violin-codex-qwen")),
                "exec", "--ephemeral", "--skip-git-repo-check", "-C", str(cwd),
                "-s", "workspace-write" if mode == "implement" else "read-only",
                "--json", "-o", str(result), "-"]
    return [os.environ.get("VIOLIN_AGY_BIN", str(Path.home() / ".local/bin/agy")),
            "--add-dir", str(cwd), "--model", "gemini-3.8-flash-medium", "--mode",
            "accept-edits" if mode == "implement" else "plan", "--sandbox",
            "--output-format", "json", "--print-timeout", f"{timeout}s", "--print"]


def terminate_process(proc):
    if proc is None or proc.poll() is not None:
        return
    try:
        proc.stdin.close()
    except (AttributeError, OSError):
        pass
    try:
        os.killpg(proc.pid, signal.SIGTERM)
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
    except ProcessLookupError:
        proc.wait()


def metadata_preflight(run):
    completed = subprocess.run([str(METADATA)], capture_output=True, text=True)
    try:
        evidence = json.loads(completed.stdout)
    except (ValueError, TypeError):
        evidence = {"error": "metadata checker returned invalid evidence"}
    atomic_json(run / "metadata.json", evidence)
    return completed.returncode == 0, evidence


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("backend", choices=["qwen", "agy"])
    parser.add_argument("--mode", choices=["inspect", "implement"], default="inspect")
    parser.add_argument("-C", "--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--task-file", type=Path)
    parser.add_argument("--timeout", type=int, default=900)
    parser.add_argument("--idle-timeout", type=int, default=300)
    parser.add_argument("--summary-chars", type=int, default=6000)
    args = parser.parse_args()
    if args.timeout <= 0 or args.idle_timeout <= 0 or args.summary_chars <= 0:
        parser.error("timeout, idle-timeout and summary-chars must be positive")
    cwd = args.cwd.resolve(strict=True)
    if not cwd.is_dir():
        parser.error("cwd must be a directory")
    task = args.task_file.read_text() if args.task_file else sys.stdin.read()
    if not task.strip():
        parser.error("a non-empty task is required")
    root = Path(os.environ.get("VIOLIN_WORKER_RUNS", str(Path.home() / ".local/state/violin-workers")))
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    run = Path(tempfile.mkdtemp(prefix=f"{args.backend}-", dir=root))
    result, started = run / "result.txt", time.monotonic()
    policy = ("Inspect only; do not change files." if args.mode == "inspect" else
              "Change only the assigned scope. Inspect the resulting diff and run relevant validation.")
    prompt = f"""You are a delegated worker. Codex is the supervisor and makes final decisions.
Assigned workspace (absolute path): {cwd}
Resolve all task-relative paths against that directory even if your terminal starts elsewhere.
Do not search supervisor session logs, enumerate environment variables, or discover unrelated workspaces.
{policy}
Follow applicable AGENTS.md and CLAUDE.md. Do not delegate further.
Do not send messages, publish, deploy, or perform destructive actions unless explicitly authorized in the task.
Report concise findings, evidence paths, commands and exit statuses, changed files,
and unresolved limitations. Never claim checks that were not run. Target <= 1200 words.
For Qwen semantic navigation use /Users/film/bin/serena-bridge; a tool error is not evidence.

Task:
{task}
"""
    (run / "task.txt").write_text(prompt)
    activity = Activity(Path(os.environ.get("VIOLIN_WORKER_STATUS", str(run / "status.json"))),
                        time.time() + args.timeout)
    activity.write()
    metadata = None
    if args.backend == "qwen":
        activity.event("metadata_check")
        ok, metadata = metadata_preflight(run)
        if not ok:
            report = {"status": "metadata_unavailable", "backend": "qwen", "exit_code": None,
                      "duration_seconds": round(time.monotonic() - activity.started, 2),
                      "evidence": str(run), "phase": "failed", "metadata": metadata,
                      "summary": "", "summary_truncated": False, "supervisor_review_required": True}
            atomic_json(run / "report.json", report)
            activity.event("failed")
            print(json.dumps(report, ensure_ascii=False))
            return 1
    cmd = command(args.backend, args.mode, cwd, result, args.timeout)
    status, code, proc, failure_reason = "failed", None, None, None
    output_done, output_thread = threading.Event(), None
    with (run / "stdout.log").open("w") as out, (run / "stderr.log").open("w") as err:
        try:
            activity.event("backend_starting")
            proc = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=err, start_new_session=True, text=True, bufsize=1)
            activity.pid = proc.pid
            activity.heartbeat()
            atomic_json(run / "process.json", {"pid": proc.pid, "backend": args.backend})

            def read_output():
                try:
                    for line in proc.stdout:
                        out.write(line)
                        out.flush()
                        try:
                            event = json.loads(line)
                        except ValueError:
                            if "metadata" in line.lower() and "fallback" in line.lower():
                                activity.failure_reason = "metadata_unavailable"
                                activity.event("failed")
                            continue
                        event_type = event.get("type", "")
                        item_type = event.get("item", {}).get("type") if isinstance(event.get("item"), dict) else ""
                        event_name = f"{event_type} {item_type}"
                        if event_type in ("turn.started", "response.created"):
                            activity.event("turn_started")
                        elif "reasoning" in event_name:
                            activity.event("reasoning")
                        elif "command_execution" in event_name and "completed" not in event_name:
                            activity.event("command_started", event_type)
                        elif "command_execution" in event_name and ("completed" in event_name or
                                                                      event.get("status") == "completed"):
                            activity.event("command_completed", event_type)
                        elif event_type in ("turn.completed", "response.completed"):
                            activity.event("completed")
                        elif event_type in ("turn.failed", "error"):
                            activity.event("failed")
                finally:
                    output_done.set()

            output_thread = threading.Thread(target=read_output, daemon=True)
            output_thread.start()
            activity.event("turn_started")
            if proc.stdin is not None:
                proc.stdin.write(prompt if args.backend == "qwen" else "")
                proc.stdin.close()
            while proc.poll() is None:
                now = time.monotonic()
                if activity.failure_reason == "metadata_unavailable":
                    status = "metadata_unavailable"
                    terminate_process(proc)
                    break
                if now - activity.last_event >= args.idle_timeout:
                    status = "idle_timeout"
                    activity.event("timeout")
                    terminate_process(proc)
                    break
                if time.time() >= activity.deadline:
                    status = "timeout"
                    activity.event("timeout")
                    terminate_process(proc)
                    break
                activity.heartbeat()
                time.sleep(0.25)
            proc.wait()
            output_done.wait(timeout=5)
            code = proc.returncode
            if status == "failed":
                status = "completed" if code == 0 else "failed"
        except KeyboardInterrupt:
            status = "interrupted"
            activity.event("interrupted")
            terminate_process(proc)
            if proc is not None:
                code = proc.returncode
        except OSError as exc:
            err.write(str(exc))
            activity.event("failed")
        finally:
            if output_thread is not None:
                output_done.wait(timeout=5)
    usage = None
    if args.backend == "agy" and status == "completed":
        try:
            data = json.loads((run / "stdout.log").read_text())
            if data.get("status") != "SUCCESS" or not isinstance(data.get("response"), str):
                status = "failed"
                failure_reason = "provider_failure"
            else:
                result.write_text(data["response"])
                usage = data.get("usage")
        except (ValueError, TypeError):
            status = "failed"
            failure_reason = "provider_failure"
    if args.backend == "qwen":
        for line in (run / "stdout.log").read_text().splitlines():
            try:
                event = json.loads(line)
                if event.get("type") == "turn.completed":
                    usage = event.get("usage")
                if event.get("type") in ("turn.failed", "error") and status == "completed":
                    status = "failed"
                    failure_reason = "provider_failure"
            except ValueError:
                pass
    summary = result.read_text() if result.exists() else ""
    if status == "completed" and not summary.strip():
        status = "failed"
        failure_reason = "provider_failure"
    phase = json.loads(activity.path.read_text()).get("phase")
    report = {"status": status, "backend": args.backend, "exit_code": code,
              "duration_seconds": round(time.monotonic() - started, 2), "evidence": str(run),
              "phase": phase, "metadata": metadata, "usage": usage,
              "summary": summary[:args.summary_chars], "summary_truncated": len(summary) > args.summary_chars,
              "supervisor_review_required": True}
    if failure_reason:
        report["failure_reason"] = failure_reason
    atomic_json(run / "report.json", report)
    print(json.dumps(report, ensure_ascii=False))
    return 0 if status == "completed" else 1


if __name__ == "__main__":
    def terminate(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, terminate)
    sys.exit(main())
