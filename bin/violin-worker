#!/usr/bin/env python3
"""Canonical bounded worker for Qwen, AGY, and Claude (Delegation Protocol v1)."""
import argparse, json, os, shlex, signal, subprocess, sys, tempfile, threading, time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
HEALTH = ROOT / "violin-health"

def atomic_json(path, value):
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2)); os.replace(tmp, path)

def git_state(cwd):
    try:
        p = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"], cwd=cwd, capture_output=True, text=True, check=False)
        return p.returncode, set(x for x in p.stdout.splitlines() if x)
    except OSError: return 1, set()

def changed_paths(before, after, cwd, ignored):
    result = set()
    for line in after - before:
        path = line[3:] if len(line) >= 4 else line
        try: (cwd / path).resolve().relative_to(ignored)
        except ValueError: result.add(path)
    return sorted(result)

def event_text(event):
    values = []; item = event.get("item") if isinstance(event.get("item"), dict) else {}
    for value in (item.get("text"), item.get("content"), item.get("message"), event.get("text"), event.get("message")):
        if isinstance(value, str): values.append(value)
        elif isinstance(value, list):
            for part in value:
                if isinstance(part, str): values.append(part)
                elif isinstance(part, dict) and isinstance(part.get("text"), str): values.append(part["text"])
    return "\n".join(values)

class Activity:
    def __init__(self, path, deadline):
        self.path, self.deadline = path, deadline; self.started = time.monotonic(); self.last_event = self.started
        self.last_event_at = time.time(); self.phase = "starting"; self.command_type = self.pid = None; self.lock = threading.Lock()
        self.command_active = False
    def write(self):
        atomic_json(self.path, {"phase": self.phase, "last_event_at": self.last_event_at, "elapsed_seconds": round(time.monotonic()-self.started, 2), "pid": self.pid, "timeout_deadline": self.deadline, "command_type": self.command_type, "evidence": str(self.path.parent)})
    def event(self, phase, command_type=None, command_active=None):
        with self.lock:
            self.phase = phase
            if command_type: self.command_type = command_type
            if command_active is not None: self.command_active = command_active
            self.last_event = time.monotonic(); self.last_event_at = time.time(); self.write()
    def heartbeat(self):
        with self.lock: self.write()

def terminate(proc):
    if proc is None or proc.poll() is not None: return
    try: proc.stdin.close()
    except (AttributeError, OSError): pass
    try: os.killpg(proc.pid, signal.SIGTERM); proc.wait(timeout=5)
    except subprocess.TimeoutExpired: os.killpg(proc.pid, signal.SIGKILL); proc.wait()
    except ProcessLookupError: proc.wait()

def custom_command(backend, mode, cwd, result, timeout, prompt, task_file):
    raw = os.environ.get(f"VIOLIN_{backend.upper()}_COMMAND")
    if not raw:
        return None
    try:
        value = json.loads(raw)
    except ValueError:
        value = raw
    parts = [str(x) for x in value] if isinstance(value, list) else shlex.split(str(value))
    values = {"backend": backend, "mode": mode, "workspace": str(cwd),
              "task_file": str(task_file), "result_file": str(result),
              "timeout": str(timeout), "idle_timeout": os.environ.get("VIOLIN_IDLE_TIMEOUT", "300"),
              "prompt": prompt}
    try:
        return [part.format(**values) for part in parts]
    except KeyError as exc:
        raise ValueError(f"Unknown command placeholder: {{{exc.args[0]}}}")


def command(backend, mode, cwd, result, timeout, prompt, task_file):
    configured = custom_command(backend, mode, cwd, result, timeout, prompt, task_file)
    if configured is not None:
        return configured
    if backend == "qwen":
        return [os.environ.get("VIOLIN_QWEN_BIN", str(Path.home()/"bin/violin-codex-qwen")), "exec", "--ephemeral", "--skip-git-repo-check", "-C", str(cwd), "-s", "workspace-write" if mode == "implement" else "read-only", "--json", "-o", str(result), "-"]
    if backend == "agy":
        return [os.environ.get("VIOLIN_AGY_BIN", str(Path.home()/".local/bin/agy")), "--add-dir", str(cwd), "--model", "gemini-3.8-flash-medium", "--mode", "accept-edits" if mode == "implement" else "plan", "--sandbox", "--output-format", "json", "--print-timeout", f"{timeout}s", "--print", prompt]
    return [os.environ.get("VIOLIN_CLAUDE_BIN", str(Path.home()/"bin/violin-claude")), "--print", "--model", "claude-sonnet-5", "--permission-mode", "acceptEdits" if mode == "implement" else "plan", "--add-dir", str(cwd), "--output-format", "stream-json", "--verbose", prompt]

def health(run, deadline):
    try:
        p = subprocess.run([str(HEALTH)], capture_output=True, text=True, timeout=max(1, min(60, int(deadline-time.monotonic())))); value = json.loads(p.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc: p = None; value = {"status":"metadata_unavailable", "error":type(exc).__name__}
    atomic_json(run/"health.json", value); atomic_json(run/"metadata.json", value.get("metadata", {"status":"unavailable", "error":value.get("error")}))
    if p is None or p.returncode == 78: return value, "metadata_unavailable"
    if p.returncode != 0: return value, "qwen_unhealthy"
    return value, None

def make_report(status, backend, code, run, started, activity, metadata, metadata_status, smoke_status, final, changed, diff, error=None, usage=None, summary="", summary_chars=6000):
    try: phase = json.loads(activity.path.read_text()).get("phase")
    except (OSError, ValueError): phase = "failed"
    report = {"status":status, "backend":backend, "exit_code":code, "duration_seconds":round(time.monotonic()-started,2), "evidence":str(run), "phase":phase, "metadata":metadata, "metadata_status":metadata_status, "smoke_status":smoke_status, "usage":usage, "summary":summary[:summary_chars], "summary_truncated":len(summary)>summary_chars, "supervisor_review_required":True, "final_message_seen":final, "changed_files":changed, "git_diff_check":diff}
    if error: report["error_message"] = error
    if status in ("provider_error", "qwen_unhealthy", "invalid_json", "empty_final_response") or (error and status == "failed"):
        report["failure_reason"] = "provider_error" if status == "provider_error" else status
    return report

def main():
    ap=argparse.ArgumentParser(description=__doc__); ap.add_argument("backend", choices=["qwen","agy","claude"]); ap.add_argument("--mode",choices=["inspect","implement"],default="inspect"); ap.add_argument("-C","--cwd",type=Path,default=Path.cwd()); ap.add_argument("--task-file",type=Path); ap.add_argument("--timeout",type=int,default=900); ap.add_argument("--idle-timeout",type=int,default=300); ap.add_argument("--summary-chars",type=int,default=6000); a=ap.parse_args()
    if min(a.timeout,a.idle_timeout,a.summary_chars)<=0: ap.error("timeouts and summary-chars must be positive")
    os.environ["VIOLIN_IDLE_TIMEOUT"] = str(a.idle_timeout)
    cwd=a.cwd.resolve(strict=True); task=a.task_file.read_text() if a.task_file else sys.stdin.read()
    if not task.strip(): ap.error("a non-empty task is required")
    root=Path(os.environ.get("VIOLIN_WORKER_RUNS",str(Path.home()/".local/state/violin-workers"))); root.mkdir(parents=True,exist_ok=True,mode=0o700); run=Path(tempfile.mkdtemp(prefix=f"{a.backend}-",dir=root)); started=time.monotonic(); deadline=started+a.timeout; result=run/"result.txt"
    activity=Activity(Path(os.environ.get("VIOLIN_WORKER_STATUS",str(run/"status.json"))),time.time()+a.timeout); activity.write(); metadata=None; metadata_status="not_applicable"; smoke_status="not_applicable"
    custom = os.environ.get(f"VIOLIN_{a.backend.upper()}_CUSTOM") == "1"
    protocol = os.environ.get(f"VIOLIN_{a.backend.upper()}_PROTOCOL", a.backend)
    if a.backend=="qwen" and not custom:
        metadata,failure=health(run,deadline); metadata_status=metadata.get("metadata_status","unavailable"); smoke_status=metadata.get("smoke_status","not_run")
        if failure:
            report=make_report(failure,a.backend,None,run,started,activity,metadata,metadata_status,smoke_status,False,[],{},metadata.get("error")); atomic_json(run/"report.json",report); print(json.dumps(report,ensure_ascii=False)); return 1
    baseline_code,baseline=git_state(cwd); policy="Inspect only; do not change files." if a.mode=="inspect" else "Change only the assigned scope. Inspect the resulting diff and run relevant validation."
    prompt=f"""You are a delegated worker. Codex is the supervisor and makes final decisions.
Assigned workspace (absolute path): {cwd}
Resolve all task-relative paths against that directory. {policy}
Follow applicable AGENTS.md and CLAUDE.md. Do not delegate further. Report concise findings, evidence paths, commands and exit statuses, changed files, and unresolved limitations. Never claim checks that were not run.

Task:
{task}
"""; (run/"task.txt").write_text(prompt)
    try:
        cmd=command(a.backend,a.mode,cwd,result,a.timeout,prompt,run/"task.txt")
    except (OSError, ValueError) as exc:
        activity.event("failed")
        report=make_report("failed",a.backend,None,run,started,activity,metadata,metadata_status,smoke_status,False,[],{},str(exc),None,"",a.summary_chars)
        report["failure_reason"]="config_error"
        atomic_json(run/"report.json",report); print(json.dumps(report,ensure_ascii=False)); return 1
    proc=None; done=threading.Event(); state={"text":[],"raw":[],"error":None,"terminal":False,"terminal_status":None,"usage":None}; status="failed"; code=None
    state["metadata_degraded"] = False
    with (run/"stdout.log").open("w") as out,(run/"stderr.log").open("w") as err:
        try:
            activity.event("backend_starting"); proc=subprocess.Popen(cmd,cwd=cwd,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=err,start_new_session=True,text=True,bufsize=1); activity.pid=proc.pid; activity.heartbeat(); atomic_json(run/"process.json",{"pid":proc.pid,"backend":a.backend})
            def read_output():
                try:
                    for line in proc.stdout:
                        out.write(line); out.flush(); state["raw"].append(line)
                        try: event=json.loads(line)
                        except ValueError:
                            if protocol == "claude" and line.strip(): state["invalid_json"] = True
                            if "metadata" in line.lower() and "fallback" in line.lower(): state["metadata_degraded"] = True
                            continue
                        typ=event.get("type",""); item=event.get("item") if isinstance(event.get("item"),dict) else {}; ityp=item.get("type","")
                        command_event = "command_execution" in typ or "command_execution" in ityp
                        if command_event:
                            completed = "completed" in typ or str(item.get("status", "")).lower() in ("completed", "success")
                            activity.event("command_completed" if completed else "command_started",
                                           ityp or typ,
                                           command_active=(not completed and "command_execution" in ityp))
                        elif typ in ("response.created","turn.started"): activity.event("turn_started")
                        if typ=="response.output_text.delta": state["text"].append(event.get("delta", ""))
                        if typ=="response.output_text.done" and event.get("text"): state["text"].append(event["text"])
                        if typ=="item.completed" and ityp=="agent_message": state["text"].append(event_text(event))
                        if typ=="item.completed" and ityp=="error": state["error"]=event_text(event) or str(event.get("error") or "provider returned an error")
                        if typ in ("error","turn.failed"): state["error"]=event_text(event) or str(event.get("error") or "provider returned an error")
                        if protocol == "claude":
                            message = event.get("message") if isinstance(event.get("message"), dict) else {}
                            content = message.get("content") if isinstance(message.get("content"), list) else []
                            for block in content:
                                if isinstance(block, dict) and isinstance(block.get("text"), str): state["text"].append(block["text"])
                            if typ == "result":
                                state["terminal"] = True
                                state["terminal_status"] = event.get("subtype")
                                state["usage"] = event.get("usage")
                                if isinstance(event.get("result"), str): state["final_result"] = event["result"]
                                if event.get("subtype") != "success" or event.get("is_error"):
                                    state["error"] = state["error"] or event.get("result") or event.get("error") or "Claude returned an error"
                                activity.event("completed" if not state["error"] else "failed")
                        if typ in ("response.completed","turn.completed") and protocol == "qwen":
                            state["terminal"]=True; response=event.get("response") if isinstance(event.get("response"),dict) else {}; state["terminal_status"]=response.get("status",event.get("status")); state["usage"]=event.get("usage"); state["error"]=state["error"] or event_text(response) or str(response.get("error") or event.get("error") or "") or None; incomplete=response.get("incomplete_details") or event.get("incomplete_details"); state["error"]=state["error"] or (str(incomplete) if incomplete else None); activity.event("completed" if not state["error"] else "failed")
                finally: done.set()
            threading.Thread(target=read_output,daemon=True).start(); activity.event("turn_started")
            send_stdin = custom and os.environ.get(f"VIOLIN_{a.backend.upper()}_STDIN") == "1"
            if (protocol == "qwen" and not custom) or send_stdin:
                proc.stdin.write(prompt)
            proc.stdin.close()
            idle_timeout_enabled = not (a.backend == "agy" and protocol == "agy" and not custom)
            while proc.poll() is None:
                if time.monotonic()>=deadline: status="timeout"; activity.event("timeout"); terminate(proc); break
                if (idle_timeout_enabled and not activity.command_active and
                        time.monotonic()-activity.last_event>=a.idle_timeout):
                    status="idle_timeout"; activity.event("timeout"); terminate(proc); break
                activity.heartbeat(); time.sleep(.1)
            proc.wait(); done.wait(5); code=proc.returncode
            if status == "failed": status="completed" if code==0 else "failed"
        except KeyboardInterrupt: status="interrupted"; activity.event("interrupted"); terminate(proc); code=proc.returncode if proc else None
        except OSError as exc: status="failed"; err.write(str(exc)); activity.event("failed")
    if custom and status == "completed":
        try:
            payload_text = "".join(state["raw"])
            if not payload_text and result.exists():
                payload_text = result.read_text()
            if protocol == "text":
                result.write_text(payload_text.strip())
                state["text"] = [payload_text.strip()]
            elif protocol == "json":
                payload = json.loads(payload_text)
                if isinstance(payload, str):
                    value = payload
                elif isinstance(payload, dict):
                    if payload.get("status") not in (None, "SUCCESS", "success", "completed"):
                        raise ValueError(payload.get("error") or "configured command returned an error")
                    value = payload.get("response", payload.get("result", payload.get("output", payload.get("text", ""))))
                else:
                    raise ValueError("configured JSON command returned an unsupported value")
                if not isinstance(value, str) or not value.strip():
                    raise ValueError("configured command returned no text result")
                result.write_text(value)
                state["text"] = [value]
            else:
                raise ValueError(f"Unsupported custom protocol: {protocol}")
            state["terminal"] = True
        except (ValueError, TypeError, OSError) as exc:
            status = "failed"
            state["error"] = str(exc)
    if protocol=="agy" and status=="completed" and not custom:
        try:
            payload=json.loads((run/"stdout.log").read_text())
            if payload.get("status")!="SUCCESS" or not isinstance(payload.get("response"),str): raise ValueError(payload.get("error") or "AGY returned a non-success payload")
            result.write_text(payload["response"]); state["text"]=[payload["response"]]; state["usage"]=payload.get("usage")
        except (ValueError,TypeError,OSError) as exc: status="failed"; state["error"]=str(exc)
    if protocol == "claude" and state.get("final_result"):
        result.write_text(state["final_result"])
    if protocol == "claude" and not custom:
        try:
            provider_stderr = (run / "stderr.log").read_text()
        except OSError:
            provider_stderr = ""
        if any(marker in provider_stderr.lower() for marker in
               ("authenticate", "oauth", "authentication", "model not found", "provider error")):
            state["error"] = state["error"] or provider_stderr.strip()
            state["credential_error"] = provider_stderr.strip()
    message=result.read_text() if result.exists() else ""; accumulated="".join(state["text"])
    if not message and accumulated.strip(): result.write_text(accumulated); message=accumulated
    final=bool(message.strip())
    if protocol == "claude" and state.get("invalid_json"):
        status = "invalid_json"
        state["error"] = state["error"] or "Claude emitted invalid JSON"
    if state["error"] and (status == "completed" or (a.backend in ("qwen", "claude") and status == "failed")): status="provider_error"
    if protocol in ("qwen", "claude") and status=="completed" and (not state["terminal"] or state["terminal_status"] in ("failed","incomplete","error_during_execution") or not final): status="empty_final_response" if not final else "provider_error"
    after_code,after=git_state(cwd); changed=changed_paths(baseline,after,cwd,root.resolve()); diff={"before_status_exit":baseline_code,"after_status_exit":after_code,"new_changed_files":changed}
    if a.mode=="implement" and status=="completed" and not changed: status="no_changes"
    report=make_report(status,a.backend,code,run,started,activity,metadata,metadata_status,smoke_status,final,changed,diff,state["error"],state["usage"],message,a.summary_chars)
    if protocol == "claude" and not custom: report["claude_model"] = "claude-sonnet-5"
    if protocol == "claude" and state.get("credential_error"):
        report["credential_error"] = state["credential_error"][:a.summary_chars]
    if state.get("metadata_degraded"): report["status_detail"] = "metadata_degraded"
    atomic_json(run/"report.json",report); print(json.dumps(report,ensure_ascii=False)); return 0 if status=="completed" else 1

if __name__=="__main__":
    signal.signal(signal.SIGTERM,lambda *_: (_ for _ in ()).throw(KeyboardInterrupt())); sys.exit(main())
