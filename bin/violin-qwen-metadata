#!/usr/bin/env python3
"""Validate the Codex model metadata required by the LAN Qwen route."""
import datetime as dt
import json
import os
from pathlib import Path
import subprocess
import sys

MODEL, PROVIDER, WIRE_API, CONTEXT_WINDOW = "qwen3.8-27b", "violin_lan", "responses", 200000


def parse_time(value):
    if not isinstance(value, str):
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def provider_ok(entry):
    providers = entry.get("providers")
    if isinstance(providers, dict):
        provider = providers.get(PROVIDER)
        return (isinstance(provider, dict) and provider.get("wire_api") == WIRE_API) or provider == WIRE_API
    return (entry.get("provider") == PROVIDER or entry.get("model_provider") == PROVIDER) and entry.get("wire_api") == WIRE_API


def effective_entry():
    codex = os.environ.get("VIOLIN_CODEX_BIN", "/opt/homebrew/bin/codex")
    if not Path(codex).is_file():
        return None, "Codex CLI binary is missing"
    command = [codex, "-c", 'model="qwen3.8-27b"', "-c", 'model_provider="violin_lan"',
               "-c", "model_context_window=200000", "-c",
               'model_providers.violin_lan.wire_api="responses"', "debug", "models"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5)
        data = json.loads(result.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError) as exc:
        return None, f"effective metadata query failed: {type(exc).__name__}"
    models = data.get("models", []) if isinstance(data, dict) else []
    entry = next((m for m in models if isinstance(m, dict) and m.get("slug") == MODEL), None)
    if entry is None:
        return None, "effective metadata does not contain qwen3.8-27b"
    return entry, None


def check(cache_path=None, now=None):
    path = Path(cache_path or os.environ.get("VIOLIN_CODEX_MODELS_CACHE", str(Path.home() / ".codex/models_cache.json")))
    evidence = {"cache_path": str(path), "model": MODEL, "provider": PROVIDER,
                "wire_api": WIRE_API, "cache_timestamp": None}
    try:
        data = json.loads(path.read_text())
        evidence["cache_timestamp"] = data.get("fetched_at") if isinstance(data, dict) else None
        models = data.get("models", []) if isinstance(data, dict) else []
    except (OSError, ValueError, TypeError) as exc:
        data, models = {}, []
        cache_error = f"cache_read_error: {type(exc).__name__}"
    else:
        cache_error = None
    entry = next((m for m in models if isinstance(m, dict) and m.get("slug") == MODEL), None)
    source = "models_cache"
    if entry is None or not provider_ok(entry):
        cache_error = cache_error or "model entry is missing"
        effective_entry_value, effective_error = effective_entry()
        if effective_entry_value is not None:
            entry = effective_entry_value
            source = "codex_debug_models" if entry.get("shell_type") else "launcher_config"
        else:
            errors = [cache_error, effective_error]
            evidence["error"] = "; ".join(errors)
            return False, evidence
    evidence["metadata_source"] = source
    errors = []
    if entry is None:
        errors.append("model entry is missing")
    else:
        evidence["context_window"] = entry.get("context_window")
        evidence["reasoning_modes"] = [r.get("effort") for r in entry.get("supported_reasoning_levels", []) if isinstance(r, dict)]
        if entry.get("context_window", 0) < CONTEXT_WINDOW:
            errors.append("context window is missing or smaller than 200000")
        if "medium" not in evidence["reasoning_modes"]:
            errors.append("medium reasoning mode is missing")
        if entry.get("supported_in_api") is not True:
            errors.append("Responses API support is missing")
        if source == "models_cache" and not provider_ok(entry):
            errors.append("violin_lan Responses provider metadata is missing")
    fetched = parse_time(data.get("fetched_at") if isinstance(data, dict) else None)
    if source == "models_cache":
        if fetched is None:
            errors.append("cache timestamp is missing or invalid")
        elif ((now or dt.datetime.now(dt.timezone.utc)) - fetched).total_seconds() > int(os.environ.get("VIOLIN_METADATA_MAX_AGE", "86400")):
            errors.append("cache is stale")
    if errors:
        evidence["error"] = "; ".join(errors)
        return False, evidence
    evidence["status"] = "healthy" if source == "models_cache" else "degraded"
    return True, evidence


if __name__ == "__main__":
    if len(sys.argv) > 2:
        print("usage: violin-qwen-metadata [CACHE_PATH]", file=sys.stderr)
        sys.exit(2)
    ok, evidence = check(sys.argv[1] if len(sys.argv) == 2 else None)
    print(json.dumps(evidence, ensure_ascii=False))
    sys.exit(0 if ok else 78)
